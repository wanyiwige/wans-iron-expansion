"""Inventory silhouettes share the modeled garment's actual pixel palette."""
from pathlib import Path
from PIL import Image,ImageDraw
import json
root=Path(__file__).resolve().parents[1];tex=root/'src/main/resources/assets/alex_caves_spellsbook/textures/item';art=root/'artwork/candy-wizard-armor-20261017'
dark='#30203D';cloth='#64416F';pink='#BC658C';cream='#F4DDB6';mint='#92C7B0';gold='#C49356'
items=['hat','robe','leggings','boots'];ims=[]
for kind in items:
 im=Image.new('RGBA',(16,16));d=ImageDraw.Draw(im)
 if kind=='hat':
  d.polygon([(1,12),(4,10),(6,5),(8,1),(11,0),(12,2),(10,2),(11,6),(12,10),(15,12),(13,14),(3,14)],fill=dark)
  d.polygon([(5,10),(7,5),(8,2),(10,1),(9,3),(10,7),(11,11)],fill=cloth)
  d.line((4,11,12,11),fill=pink,width=2);d.rectangle((7,10,8,12),fill=gold)
  d.line((2,13,13,13),fill=cream);d.point((8,6),fill=cream);d.point((9,7),fill=gold)
 elif kind=='robe':
  d.polygon([(5,1),(10,1),(14,4),(15,9),(12,10),(11,7),(11,15),(4,15),(4,7),(3,10),(0,9),(1,4)],fill=dark)
  d.rectangle((5,3,10,14),fill=cloth);d.polygon([(5,1),(7,4),(6,6),(4,3)],fill=cream);d.polygon([(10,1),(8,4),(9,6),(11,3)],fill=cream)
  d.rectangle((0,8,3,9),fill=cream);d.rectangle((12,8,15,9),fill=cream);d.line((1,7,3,7),fill=mint);d.line((12,7,14,7),fill=mint)
  d.rectangle((7,5,8,6),fill=pink);d.line((4,10,11,10),fill=pink);d.rectangle((7,10,8,11),fill=gold);d.line((4,14,11,14),fill=cream)
 elif kind=='leggings':
  d.rectangle((3,0,12,4),fill=pink);d.rectangle((7,1,8,2),fill=gold)
  d.rectangle((3,4,6,14),fill=dark);d.rectangle((9,4,12,14),fill=dark);d.line((4,4,4,12),fill=cream);d.line((10,4,10,12),fill=cream)
  d.line((5,4,5,12),fill=cloth);d.line((11,4,11,12),fill=cloth);d.rectangle((3,13,6,14),fill=cream);d.rectangle((9,13,12,14),fill=cream)
  d.rectangle((1,3,2,6),fill=mint);d.point((1,2),fill=gold)
 else:
  for x in [1,9]:
   d.rectangle((x+1,3,x+4,11),fill=dark);d.rectangle((x,10,x+4,13),fill=cloth);d.rectangle((x,13,x+4,14),fill='#9F6B46');d.line((x+1,4,x+4,4),fill=cream);d.rectangle((x+2,6,x+3,7),fill=gold)
 name='candy_wizard_'+kind;im.save(tex/(name+'.png'));(tex/(name+'.png.mcmeta')).write_text(json.dumps({'texture':{'blur':False,'clamp':True}}));ims.append((name,im))
sheet=Image.new('RGB',(640,185),'#252B35');d=ImageDraw.Draw(sheet)
for i,(name,im) in enumerate(ims):
 im=im.resize((128,128),Image.Resampling.NEAREST);sheet.paste(im,(i*160+12,12),im);d.text((i*160+12,152),name.replace('candy_wizard_',''),fill='white')
sheet.save(art/'inventory-icons.png')
